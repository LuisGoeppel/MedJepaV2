  "loss": {
    "lambda_sigreg": [0.01, 0.02, 0.05],
    "sigreg_knots": 17,
    "sigreg_num_projections": 1024,
    "sigreg_mode": "pooled_views",
    "sigreg_normalize_by_n": false,
    "projection_normalization": "sqrt_dim"
  },
  "distributed": {"no_cuda_timing_sync": true},
  "checkpointing": {"checkpoint_every_epochs": 50, "resume_checkpoint": null},
  "diagnostics": {"diagnostic_every_batches": 50},
  "analysis": {
    "seed": 42,
    "feature_extraction": {"batch_size": 256, "num_workers": 4, "save_features": false},
    "pca": {
      "enabled": true,
      "output_format": "compact",
      "split": "val",
      "max_samples": 1998,
      "sampling": "balanced_collapsed",
      "color_by": ["collapsed_birads"]
    },
    "probe": {
      "enabled": true,
      "targets": ["collapsed_birads"],
      "probe_epochs": 50,
      "probe_batch_size": 1024,
      "probe_learning_rate": 0.001,
      "probe_weight_decay": 0.0000001,
      "probe_train_max_samples": 60000,
      "select_best_by": "val_balanced_accuracy",
      "evaluate_test": false
    }
  }
