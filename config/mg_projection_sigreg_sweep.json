  "model": {
    "backbone_name": "vit_base_patch16_224",
    "image_size": 224,
    "backbone_output_dim": 512,
    "projection_dim": [16, 64, 128],
    "projector_hidden_dim": 2048,
    "drop_path_rate": 0.1,
    "image_height": 512,
    "image_width": 512,
    "memmap_dtype": "uint16",
    "normalize_mode": "uint16",
    "percentile_low": 1.0,
    "percentile_high": 99.0
  },
  "training": {"epochs": 50, "batch_size": 128, "num_views": 4, "num_workers": 4, "grad_accum_steps": 1},
  "optimizer": {
    "learning_rate": 0.0001,
    "weight_decay": 0.05,
    "warmup_epochs": 10,
    "min_learning_rate": 0.00001,
    "grad_clip_norm": 0.0
