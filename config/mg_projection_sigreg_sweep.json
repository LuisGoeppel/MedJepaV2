{
  "schema_version": "medjepa_v7_config_0.1",
  "run": {
    "name": "mg_projection_sigreg_sweep",
    "description": "Nine 50-epoch Hologic/Lorad runs comparing projection dimension and SIGReg weight.",
    "output_dir": "/pfss/mlde/workspaces/mlde_wsp_PI_Roig/luis/runs/mg_projection_sigreg_sweep",
    "seed": 42,
    "save_resolved_config": true
  },
  "paths": {
    "full_csv": "/pfss/mlde/workspaces/mlde_wsp_PI_Roig/shared/datasets/breastTumor/mg/mg-only-all.csv",
    "bin": "/pfss/mlde/workspaces/mlde_wsp_PI_Roig/shared/datasets/breastTumor/mg/mg-only-all.bin",
    "train_csv": "/pfss/mlde/workspaces/mlde_wsp_PI_Roig/shared/datasets/breastTumor/mg/splits_hologic_lorad/mg_train.csv",
    "val_csv": "/pfss/mlde/workspaces/mlde_wsp_PI_Roig/shared/datasets/breastTumor/mg/splits_hologic_lorad/mg_val.csv",
    "test_csv": "/pfss/mlde/workspaces/mlde_wsp_PI_Roig/shared/datasets/breastTumor/mg/splits_hologic_lorad/mg_test.csv",
    "augmentation_config": "mg_lejepa_aug_v4.json"
